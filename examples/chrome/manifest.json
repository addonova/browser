{
  "manifest_version": 3,
  "name": "Addonova Browser - Chrome example",
  "version": "1.0.0",
  "description": "Minimal Chrome MV3 extension using @addonova/browser.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Addonova Browser"
  },
  "permissions": ["storage", "tabs"],
  "minimum_chrome_version": "127"
}
