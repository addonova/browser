{
  "name": "@addonova/browser",
  "version": "0.2.1",
  "description": "Unified APIs for cross-browser extensions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing/setup": {
      "types": "./dist/testing/setup.d.ts",
      "import": "./dist/testing/setup.js"
    },
    "./chrome": {
      "types": "./dist/entries/chrome.d.ts",
      "import": "./dist/entries/chrome.js"
    },
    "./chromium": {
      "types": "./dist/entries/chromium.d.ts",
      "import": "./dist/entries/chromium.js"
    },
    "./firefox": {
      "types": "./dist/entries/firefox.d.ts",
      "import": "./dist/entries/firefox.js"
    },
    "./edge": {
      "types": "./dist/entries/edge.d.ts",
      "import": "./dist/entries/edge.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "guchho-test run",
    "test:watch": "guchho-test watch"
  },
  "keywords": [
    "browser-extension",
    "webextension",
    "cross-browser",
    "chrome",
    "firefox",
    "edge",
    "addonova",
    "addon-development",
    "addon-manager",
    "addons",
    "addons-mozilla-org",
    "addons-repository",
    "chrome-extension",
    "chrome-extensions",
    "firefox-addon",
    "firefox-extension",
    "firefox-extensions",
    "firefox-webextension"
  ],
  "author": "CodeHemu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addonova/browser.git"
  },
  "homepage": "https://addonova.github.io/documentation/",
  "allowScripts": {
    "guchho@1.0.9": true
  },
  "devDependencies": {
    "@guchho/test": "^0.0.2",
    "@types/node": "^26.6.6",
    "guchho": "1.0.9",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@guchho/test": "^0.0.2"
  },
  "peerDependenciesMeta": {
    "@guchho/test": {
      "optional": true
    }
  }
}
