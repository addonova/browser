{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@addonova/browser": ["./src/index.ts"],
      "@addonova/browser/testing": ["./src/testing/index.ts"],
      "@addonova/browser/testing/setup": ["./src/testing/setup.ts"],
      "@addonova/browser/chrome": ["./src/entries/chrome.ts"],
      "@addonova/browser/chromium": ["./src/entries/chromium.ts"],
      "@addonova/browser/edge": ["./src/entries/edge.ts"],
      "@addonova/browser/firefox": ["./src/entries/firefox.ts"]
    },
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "guchho.test.config.ts"],
  "exclude": ["dist", "node_modules", "demo"]
}
