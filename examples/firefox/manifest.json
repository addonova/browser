{
  "manifest_version": 3,
  "name": "Addonova Browser - Firefox example",
  "version": "1.0.0",
  "description": "Minimal Firefox MV3 extension using @addonova/browser.",
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Addonova Browser"
  },
  "permissions": ["storage", "tabs"],
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-example@addonova.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
